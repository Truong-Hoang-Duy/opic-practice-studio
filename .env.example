# OpenAI Configuration
OPENAI_API_KEY=your_openai_api_key_here
OPENAI_MODEL=gpt-5.6-luna
# Eva Text-to-Speech (TTS): edge (Microsoft Edge Neural Voice, 0 MB server RAM, 100% free) | browser
TTS_PROVIDER=edge
EDGE_VOICE=en-US-AvaNeural
EDGE_RATE=-4%

# Speech-to-Text (STT) Configuration (100% Free)
# STT_PROVIDER:
#   "auto"           -> uses Groq Whisper Free API if GROQ_API_KEY is set, otherwise local faster-whisper (default)
#   "faster_whisper" -> open-source Whisper (CTranslate2 int8) on local CPU, auto-downloads to ./data/stt_models
#   "groq"           -> Groq Cloud Whisper Free API (whisper-large-v3-turbo), 0 MB RAM on Render/Vercel
STT_PROVIDER=auto
WHISPER_MODEL=base.en
WHISPER_LOW_MEMORY=false
GROQ_API_KEY=

# =========================================================================
# Unified Database Configuration (Dùng chung 1 DB cho cả Local và Real)
# =========================================================================
# 1. Để dùng chung 1 DB Cloud (Khuyên dùng Neon.tech miễn phí vĩnh viễn):
# DATABASE_URL=postgresql://neondb_owner:password@ep-cool-sample.ap-southeast-1.aws.neon.tech/neondb?sslmode=require
#
# 2. Hoặc nếu muốn dùng SQLite offline trên máy cá nhân:
# DATABASE_URL=sqlite:///./data/opic_studio.db
DATABASE_URL=sqlite:///./data/opic_studio.db

# JWT & Authentication Secret
SECRET_KEY=change_this_to_a_secure_random_secret_key_in_production_32_bytes_min
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# Application Environment
ENVIRONMENT=development
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:3000

# Audio Storage & Cache
AUDIO_CACHE_DIR=./data/audio_cache
AUDIO_UPLOAD_DIR=./data/uploads
REPORTS_DIR=./data/reports
